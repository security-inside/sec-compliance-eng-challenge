# Local demonstration credentials only. Replace them before any shared deployment.
POSTGRES_DB=compliance
POSTGRES_USER=compliance_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://compliance_app:replace-with-a-long-random-password@db:5432/compliance

# JSON object mapping agent bearer tokens to their authorized server identifiers.
# Keep tokens unique per agent and never commit real credentials.
AGENT_TOKENS={"replace-agent-token":"demo-linux-01"}
VIEWER_TOKEN=replace-with-a-different-long-random-token

S3_ENDPOINT_URL=http://storage:9000
S3_ACCESS_KEY=minio-demo-access
S3_SECRET_KEY=replace-with-a-long-random-storage-secret
S3_BUCKET=compliance-evidence

CORS_ORIGINS=http://localhost:8080
RETENTION_DAYS=30
MAX_REQUEST_BYTES=1048576

